# Server Port (Render sets this dynamically)
PORT=5000

# MongoDB Atlas Connection URI
# Replace with your MongoDB Atlas connection string:
# Format: mongodb+srv://<username>:<password>@<cluster-url>/studentDB?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://admin:YourPassword123@cluster0.abcde.mongodb.net/studentDB?retryWrites=true&w=majority

# Frontend URL (For CORS validation)
# In development: http://localhost:3000
# In production on Render: Set this to your Netlify site URL (e.g., https://your-site.netlify.app)
FRONTEND_URL=https://student-management-system.netlify.app

# Environment Mode
NODE_ENV=development
